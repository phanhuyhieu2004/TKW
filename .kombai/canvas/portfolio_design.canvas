      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;700;800&family=Space+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-bg: #12091f;\n    --color-neon-flame: #FF4F00;\n    --color-magenta-bloom: #D1227A;\n    --color-brand-purple: #8a5cff;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: white;\n    font-family: 'Sora', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-mono { font-family: 'Space Mono', monospace; }\n\n  /* Glitch Effect */\n  .glitch-text {\n    position: relative;\n    display: inline-block;\n  }\n  .glitch-text::before,\n  .glitch-text::after {\n    content: attr(data-text);\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: var(--color-bg);\n  }\n  .glitch-text::before {\n    left: 2px;\n    text-shadow: -2px 0 var(--color-neon-flame);\n    clip-path: inset(45% 0 45% 0);\n    animation: glitch-anim 5s infinite linear alternate-reverse;\n  }\n  .glitch-text::after {\n    left: -2px;\n    text-shadow: -2px 0 var(--color-magenta-bloom);\n    clip-path: inset(50% 0 30% 0);\n    animation: glitch-anim-2 5s infinite linear alternate-reverse;\n  }\n\n  @keyframes glitch-anim {\n    0% { clip-path: inset(80% 0 1% 0); }\n    20% { clip-path: inset(33% 0 29% 0); }\n    40% { clip-path: inset(54% 0 21% 0); }\n    60% { clip-path: inset(15% 0 63% 0); }\n    80% { clip-path: inset(92% 0 5% 0); }\n    100% { clip-path: inset(25% 0 39% 0); }\n  }\n  @keyframes glitch-anim-2 {\n    0% { clip-path: inset(10% 0 85% 0); }\n    20% { clip-path: inset(45% 0 35% 0); }\n    40% { clip-path: inset(22% 0 70% 0); }\n    60% { clip-path: inset(65% 0 10% 0); }\n    80% { clip-path: inset(12% 0 55% 0); }\n    100% { clip-path: inset(30% 0 25% 0); }\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 6px; height: 6px; }\n  ::-webkit-scrollbar-track { background: var(--color-bg); }\n  ::-webkit-scrollbar-thumb { background: #321a7f; border-radius: 10px; }\n  ::-webkit-scrollbar-thumb:hover { background: var(--color-brand-purple); }\n\n  /* Horizontal Scroll Section */\n  .horizontal-scroll {\n    display: flex;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    gap: 2rem;\n    padding: 2rem 0;\n  }\n  .tarot-card {\n    flex: 0 0 350px;\n    scroll-snap-align: center;\n  }\n\n  /* Glassmorphism */\n  .glass {\n    background: rgba(27, 16, 49, 0.4);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  /* Animations */\n  @keyframes rotate-slow {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(360deg); }\n  }\n  .animate-rotate-slow { animation: rotate-slow 20s linear infinite; }\n\n  @keyframes float {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(-20px); }\n  }\n  .animate-float { animation: float 6s ease-in-out infinite; }\n\n  .neon-border-dash {\n    border: 1px dashed rgba(255, 79, 0, 0.3);\n    transition: all 0.3s ease;\n  }\n  .neon-border-dash:hover {\n    border-color: var(--color-neon-flame);\n    box-shadow: 0 0 15px rgba(255, 79, 0, 0.2);\n  }\n\n  /* Terminal Cursor */\n  .cursor {\n    display: inline-block;\n    width: 10px;\n    height: 1.2em;\n    background: var(--color-neon-flame);\n    margin-left: 5px;\n    animation: blink 1s step-end infinite;\n    vertical-align: middle;\n  }\n  @keyframes blink { 50% { opacity: 0; } }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <div class=\"fixed inset-0 -z-20 overflow-hidden\" data-kid=\"2\">\n    <video src=\"https://videos.pexels.com/video-files/35047402/14846417_360_640_30fps.mp4\" poster=\"https://images.pexels.com/videos/35047402/pexels-photo-35047402.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=630\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover opacity-15\" data-kid=\"3\"></video>\n  </div>\n  \n  \n  <div class=\"fixed inset-0 -z-10 pointer-events-none overflow-hidden\" data-kid=\"4\">\n    <div class=\"absolute top-0 left-1/4 w-[500px] h-[500px] bg-[var(--color-brand-purple)]/20 blur-[120px] rounded-full\" data-kid=\"5\"></div>\n    <div class=\"absolute bottom-0 right-1/4 w-[600px] h-[600px] bg-[var(--color-magenta-bloom)]/10 blur-[150px] rounded-full\" data-kid=\"6\"></div>\n  </div>\n\n  \n  <nav class=\"fixed top-0 left-0 w-full z-50 px-8 py-6 flex justify-between items-center backdrop-blur-sm bg-black/10\" data-kid=\"7\">\n    <div class=\"flex items-center gap-2\" data-kid=\"8\">\n      <div class=\"w-8 h-8 bg-gradient-to-br from-[var(--color-brand-purple)] to-[var(--color-magenta-bloom)] rounded-lg\" data-kid=\"9\"></div>\n      <span class=\"font-bold tracking-tighter text-xl\" data-kid=\"10\">ALCHEMY.FE</span>\n    </div>\n    <div class=\"hidden md:flex gap-10 text-sm font-medium tracking-widest uppercase\" data-kid=\"11\">\n      <a href=\"#hero\" class=\"hover:text-[var(--color-neon-flame)] transition-colors\" data-kid=\"12\">Evocation</a>\n      <a href=\"#story\" class=\"hover:text-[var(--color-neon-flame)] transition-colors\" data-kid=\"13\">The Arcana</a>\n      <a href=\"#projects\" class=\"hover:text-[var(--color-neon-flame)] transition-colors\" data-kid=\"14\">Agglomeration</a>\n      <a href=\"#contact\" class=\"hover:text-[var(--color-neon-flame)] transition-colors\" data-kid=\"15\">Protocol</a>\n    </div>\n    <div class=\"font-mono text-xs border border-white/20 px-3 py-1 rounded-full text-white/60\" data-kid=\"16\">\n      v2.0.26_STABLE\n    </div>\n  </nav>\n\n  \n  <section id=\"hero\" class=\"relative min-h-screen flex flex-col items-center justify-center text-center px-4 overflow-hidden\" data-kid=\"17\">\n    <div class=\"relative z-10 max-w-5xl\" data-kid=\"18\">\n      <div class=\"mb-6 inline-block px-4 py-1 rounded-full border border-[var(--color-neon-flame)]/30 bg-[var(--color-neon-flame)]/5 text-[var(--color-neon-flame)] text-xs font-mono uppercase tracking-[0.3em]\" data-kid=\"19\">\n        Initiating Connection...\n      </div>\n      <h1 class=\"text-7xl md:text-9xl font-extrabold tracking-tighter leading-none mb-8\" data-kid=\"20\">\n        <span class=\"glitch-text block\" data-text=\"FRONTEND\" data-kid=\"21\">FRONTEND</span>\n        <span class=\"glitch-text block text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-brand-purple)] to-[var(--color-magenta-bloom)]\" data-text=\"ALCHEMIST\" data-kid=\"22\">ALCHEMIST</span>\n      </h1>\n      \n      <div class=\"relative mt-12 group\" data-kid=\"23\">\n        \n        <div class=\"tarot-card glass p-2 rounded-2xl animate-float max-w-xs mx-auto overflow-hidden group-hover:shadow-[0_0_50px_rgba(138,92,255,0.3)] transition-all duration-700\" data-kid=\"24\">\n          <div class=\"relative aspect-[3/4] rounded-xl overflow-hidden\" data-kid=\"25\">\n            <img src=\"https://images.unsplash.com/photo-1709377195538-5522ed0f9e10?auto=format&w=800&q=80&fit=crop\" alt=\"The Core\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 scale-110 group-hover:scale-100\" data-kid=\"26\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--color-bg)] via-transparent to-transparent opacity-80\" data-kid=\"27\"></div>\n            <div class=\"absolute bottom-6 left-6 text-left\" data-kid=\"28\">\n              <p class=\"font-mono text-[10px] uppercase text-[var(--color-neon-flame)] mb-1 tracking-widest\" data-kid=\"29\">Archetype 001</p>\n              <h3 class=\"text-xl font-bold\" data-kid=\"30\">THE CREATOR</h3>\n            </div>\n          </div>\n        </div>\n        \n        \n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/cube.svg\" class=\"absolute -top-20 -left-20 w-40 h-40 opacity-20 animate-rotate-slow pointer-events-none\" style=\"filter: invert(1) sepia(1) saturate(100) hue-rotate(240deg);\" data-kid=\"31\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/pentagram-rose.svg\" class=\"absolute -bottom-10 -right-20 w-48 h-48 opacity-10 animate-rotate-slow pointer-events-none\" style=\"filter: invert(1) sepia(1) saturate(10) hue-rotate(300deg);\" data-kid=\"32\">\n      </div>\n\n      <div class=\"mt-20 flex gap-6 justify-center\" data-kid=\"33\">\n        <a href=\"#contact\" class=\"px-8 py-4 bg-[var(--color-neon-flame)] text-black font-bold text-sm uppercase tracking-widest hover:scale-105 transition-transform\" data-kid=\"34\">\n          Execute Protocol\n        </a>\n        <a href=\"#projects\" class=\"px-8 py-4 border border-white/20 text-white font-bold text-sm uppercase tracking-widest hover:bg-white/5 transition-colors\" data-kid=\"35\">\n          View Repository\n        </a>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"story\" class=\"py-32 px-8 overflow-hidden\" data-kid=\"36\">\n    <div class=\"max-w-6xl mx-auto mb-16\" data-kid=\"37\">\n      <h2 class=\"text-sm font-mono text-[var(--color-magenta-bloom)] uppercase tracking-[0.5em] mb-4\" data-kid=\"38\">// Narrative Journey</h2>\n      <h3 class=\"text-5xl font-bold tracking-tight\" data-kid=\"39\">The Waite Arcana</h3>\n    </div>\n    \n    <div class=\"horizontal-scroll px-8 scroll-smooth\" data-kid=\"40\">\n      \n      <div class=\"tarot-card glass p-8 rounded-3xl relative overflow-hidden group\" data-kid=\"41\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/triforce.svg\" class=\"absolute -top-10 -right-10 w-40 h-40 opacity-5 group-hover:opacity-20 animate-rotate-slow transition-opacity\" style=\"filter: invert(1);\" data-kid=\"42\">\n        <div class=\"relative z-10\" data-kid=\"43\">\n          <span class=\"text-5xl font-bold text-white/10 mb-6 block\" data-kid=\"44\">01</span>\n          <h4 class=\"text-2xl font-bold mb-4 uppercase tracking-tighter text-[var(--color-neon-flame)]\" data-kid=\"45\">The Novice</h4>\n          <p class=\"text-white/60 leading-relaxed font-mono text-sm\" data-kid=\"46\">\n            In the early cycles of execution, I mastered the fundamental syntaxes. HTML tags were my runes, CSS properties my incantations.\n          </p>\n        </div>\n        <div class=\"mt-12 h-1 w-0 bg-[var(--color-neon-flame)] group-hover:w-full transition-all duration-700\" data-kid=\"47\"></div>\n      </div>\n\n      \n      <div class=\"tarot-card glass p-8 rounded-3xl relative overflow-hidden group\" data-kid=\"48\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/cube.svg\" class=\"absolute -top-10 -right-10 w-40 h-40 opacity-5 group-hover:opacity-20 animate-rotate-slow transition-opacity\" style=\"filter: invert(1);\" data-kid=\"49\">\n        <div class=\"relative z-10\" data-kid=\"50\">\n          <span class=\"text-5xl font-bold text-white/10 mb-6 block\" data-kid=\"51\">02</span>\n          <h4 class=\"text-2xl font-bold mb-4 uppercase tracking-tighter text-[var(--color-brand-purple)]\" data-kid=\"52\">The Architect</h4>\n          <p class=\"text-white/60 leading-relaxed font-mono text-sm\" data-kid=\"53\">\n            Moving beyond simple scripts, I began crafting complex structures. Component hierarchies became my blueprints for digital realms.\n          </p>\n        </div>\n        <div class=\"mt-12 h-1 w-0 bg-[var(--color-brand-purple)] group-hover:w-full transition-all duration-700\" data-kid=\"54\"></div>\n      </div>\n\n      \n      <div class=\"tarot-card glass p-8 rounded-3xl relative overflow-hidden group\" data-kid=\"55\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/pentagram-rose.svg\" class=\"absolute -top-10 -right-10 w-40 h-40 opacity-5 group-hover:opacity-20 animate-rotate-slow transition-opacity\" style=\"filter: invert(1);\" data-kid=\"56\">\n        <div class=\"relative z-10\" data-kid=\"57\">\n          <span class=\"text-5xl font-bold text-white/10 mb-6 block\" data-kid=\"58\">03</span>\n          <h4 class=\"text-2xl font-bold mb-4 uppercase tracking-tighter text-[var(--color-magenta-bloom)]\" data-kid=\"59\">The Innovator</h4>\n          <p class=\"text-white/60 leading-relaxed font-mono text-sm\" data-kid=\"60\">\n            Now, I transmute pixels into experiences. Pushing the boundaries of what a browser can manifest through creative code.\n          </p>\n        </div>\n        <div class=\"mt-12 h-1 w-0 bg-[var(--color-magenta-bloom)] group-hover:w-full transition-all duration-700\" data-kid=\"61\"></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"projects\" class=\"py-32 px-8 bg-black/20\" data-kid=\"62\">\n    <div class=\"max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-end mb-24\" data-kid=\"63\">\n      <div class=\"max-w-xl\" data-kid=\"64\">\n        <h2 class=\"text-sm font-mono text-[var(--color-neon-flame)] uppercase tracking-[0.5em] mb-4\" data-kid=\"65\">// Work History</h2>\n        <h3 class=\"text-6xl font-extrabold tracking-tighter\" data-kid=\"66\">Agglomerated & Discarded</h3>\n      </div>\n      <p class=\"text-white/40 font-mono text-xs text-right hidden md:block\" data-kid=\"67\">\n        [ DRAG TO ORGANIZE / CLICK TO EVOKE ]\n      </p>\n    </div>\n\n    <div class=\"relative h-[800px] w-full max-w-7xl mx-auto flex items-center justify-center\" data-kid=\"68\">\n      \n      <div class=\"absolute glass p-4 rounded-xl w-[400px] transform -rotate-6 -translate-x-32 -translate-y-20 hover:rotate-0 hover:scale-105 transition-all duration-500 cursor-grab active:cursor-grabbing hover:z-30\" data-kid=\"69\">\n        <div class=\"aspect-video bg-black/40 rounded-lg overflow-hidden mb-4\" data-kid=\"70\">\n           <img src=\"https://images.unsplash.com/photo-1597733336794-12d05021d510?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover\" data-kid=\"71\">\n        </div>\n        <div class=\"flex justify-between items-start\" data-kid=\"72\">\n          <div data-kid=\"73\">\n            <h4 class=\"font-bold text-lg mb-1\" data-kid=\"74\">NEBULA AI INTERFACE</h4>\n            <div class=\"flex gap-2\" data-kid=\"75\">\n              <span class=\"text-[10px] font-mono text-white/40 border border-white/10 px-2 py-0.5 rounded\" data-kid=\"76\">REACT</span>\n              <span class=\"text-[10px] font-mono text-white/40 border border-white/10 px-2 py-0.5 rounded\" data-kid=\"77\">WEBGL</span>\n            </div>\n          </div>\n          <i class=\"ti ti-external-link text-white/30\" data-kid=\"78\"></i>\n        </div>\n      </div>\n\n      <div class=\"absolute glass p-4 rounded-xl w-[420px] transform rotate-3 translate-x-40 translate-y-10 hover:rotate-0 hover:scale-105 transition-all duration-500 cursor-grab active:cursor-grabbing hover:z-30 shadow-2xl\" data-kid=\"79\">\n        <div class=\"aspect-video bg-black/40 rounded-lg overflow-hidden mb-4\" data-kid=\"80\">\n           <img src=\"https://images.pexels.com/photos/12843337/pexels-photo-12843337.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" class=\"w-full h-full object-cover\" data-kid=\"81\">\n        </div>\n        <div class=\"flex justify-between items-start\" data-kid=\"82\">\n          <div data-kid=\"83\">\n            <h4 class=\"font-bold text-lg mb-1\" data-kid=\"84\">CRYPTO-TAROT ENGINE</h4>\n            <div class=\"flex gap-2\" data-kid=\"85\">\n              <span class=\"text-[10px] font-mono text-white/40 border border-white/10 px-2 py-0.5 rounded\" data-kid=\"86\">NEXT.JS</span>\n              <span class=\"text-[10px] font-mono text-white/40 border border-white/10 px-2 py-0.5 rounded\" data-kid=\"87\">GSAP</span>\n            </div>\n          </div>\n          <i class=\"ti ti-external-link text-white/30\" data-kid=\"88\"></i>\n        </div>\n      </div>\n\n      <div class=\"absolute glass p-4 rounded-xl w-[380px] transform -rotate-12 -translate-x-10 translate-y-40 hover:rotate-0 hover:scale-105 transition-all duration-500 cursor-grab active:cursor-grabbing hover:z-30 opacity-80 hover:opacity-100\" data-kid=\"89\">\n        <div class=\"aspect-video bg-black/40 rounded-lg overflow-hidden mb-4\" data-kid=\"90\">\n           <img src=\"https://images.pexels.com/photos/31434528/pexels-photo-31434528.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\" class=\"w-full h-full object-cover\" data-kid=\"91\">\n        </div>\n        <div class=\"flex justify-between items-start\" data-kid=\"92\">\n          <div data-kid=\"93\">\n            <h4 class=\"font-bold text-lg mb-1\" data-kid=\"94\">BRUTALIST DASHBOARD</h4>\n            <div class=\"flex gap-2\" data-kid=\"95\">\n              <span class=\"text-[10px] font-mono text-white/40 border border-white/10 px-2 py-0.5 rounded\" data-kid=\"96\">TYPESCRIPT</span>\n              <span class=\"text-[10px] font-mono text-white/40 border border-white/10 px-2 py-0.5 rounded\" data-kid=\"97\">TAILWIND</span>\n            </div>\n          </div>\n          <i class=\"ti ti-external-link text-white/30\" data-kid=\"98\"></i>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"skills\" class=\"py-32 px-8\" data-kid=\"99\">\n    <div class=\"max-w-6xl mx-auto\" data-kid=\"100\">\n      <div class=\"mb-20 text-center\" data-kid=\"101\">\n        <h2 class=\"text-sm font-mono text-[var(--color-brand-purple)] uppercase tracking-[0.5em] mb-4\" data-kid=\"102\">// Mastery Matrix</h2>\n        <h3 class=\"text-5xl font-bold tracking-tight\" data-kid=\"103\">The Kumasi Grid</h3>\n      </div>\n      \n      <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4\" data-kid=\"104\">\n        \n        <div class=\"neon-border-dash p-6 rounded-lg glass col-span-2 flex flex-col justify-between\" data-kid=\"105\">\n          <i class=\"ti ti-brand-react text-4xl mb-6 text-[var(--color-neon-flame)]\" data-kid=\"106\"></i>\n          <div data-kid=\"107\">\n            <span class=\"block font-mono text-[10px] text-white/30 mb-1\" data-kid=\"108\">0xFF01</span>\n            <h4 class=\"font-bold text-xl uppercase tracking-widest\" data-kid=\"109\">REACT CORE</h4>\n          </div>\n        </div>\n        <div class=\"neon-border-dash p-6 rounded-lg glass flex flex-col justify-between\" data-kid=\"110\">\n          <i class=\"ti ti-brand-tailwind text-3xl mb-6 text-[var(--color-brand-purple)]\" data-kid=\"111\"></i>\n          <h4 class=\"font-bold text-xs uppercase tracking-widest\" data-kid=\"112\">TAILWIND</h4>\n        </div>\n        <div class=\"neon-border-dash p-6 rounded-lg glass col-span-1 lg:col-span-2 flex flex-col justify-between\" data-kid=\"113\">\n          <i class=\"ti ti-brand-javascript text-3xl mb-6 text-[var(--color-magenta-bloom)]\" data-kid=\"114\"></i>\n          <h4 class=\"font-bold text-lg uppercase tracking-widest\" data-kid=\"115\">ECOSYSTEM</h4>\n        </div>\n        <div class=\"neon-border-dash p-6 rounded-lg glass flex flex-col justify-between\" data-kid=\"116\">\n          <i class=\"ti ti-brand-framer text-3xl mb-6 text-white/40\" data-kid=\"117\"></i>\n          <h4 class=\"font-bold text-xs uppercase tracking-widest\" data-kid=\"118\">MOTION</h4>\n        </div>\n        <div class=\"neon-border-dash p-6 rounded-lg glass md:row-span-2 flex flex-col justify-center items-center text-center gap-4\" data-kid=\"119\">\n          <i class=\"ti ti-geometry text-4xl text-[var(--color-neon-flame)]\" data-kid=\"120\"></i>\n          <h4 class=\"font-bold text-xs uppercase tracking-widest leading-loose\" data-kid=\"121\">CREATIVE<br data-kid=\"122\">GEOMETRY</h4>\n        </div>\n        <div class=\"neon-border-dash p-6 rounded-lg glass col-span-2 flex flex-col justify-between\" data-kid=\"123\">\n          <i class=\"ti ti-terminal text-3xl mb-6 text-[var(--color-brand-purple)]\" data-kid=\"124\"></i>\n          <h4 class=\"font-bold text-lg uppercase tracking-widest\" data-kid=\"125\">ARCHITECTURE</h4>\n        </div>\n        <div class=\"neon-border-dash p-6 rounded-lg glass flex flex-col justify-between\" data-kid=\"126\">\n          <i class=\"ti ti-database text-3xl mb-6 text-white/40\" data-kid=\"127\"></i>\n          <h4 class=\"font-bold text-xs uppercase tracking-widest\" data-kid=\"128\">GRAPHQL</h4>\n        </div>\n        <div class=\"neon-border-dash p-6 rounded-lg glass flex flex-col justify-between bg-[var(--color-neon-flame)]/10\" data-kid=\"129\">\n          <i class=\"ti ti-bolt text-3xl mb-6 text-[var(--color-neon-flame)]\" data-kid=\"130\"></i>\n          <h4 class=\"font-bold text-xs uppercase tracking-widest\" data-kid=\"131\">PERFORMANCE</h4>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer id=\"contact\" class=\"py-32 px-8 relative\" data-kid=\"132\">\n    <div class=\"max-w-4xl mx-auto\" data-kid=\"133\">\n      <div class=\"mb-12\" data-kid=\"134\">\n        <h2 class=\"text-sm font-mono text-[var(--color-neon-flame)] uppercase tracking-[0.5em] mb-4\" data-kid=\"135\">// Final Protocol</h2>\n        <h3 class=\"text-5xl font-bold tracking-tight mb-8\" data-kid=\"136\">Establish Connection</h3>\n      </div>\n      \n      \n      <div class=\"glass rounded-2xl overflow-hidden shadow-2xl border-white/5\" data-kid=\"137\">\n        <div class=\"bg-white/5 px-6 py-3 border-b border-white/5 flex items-center gap-2\" data-kid=\"138\">\n          <div class=\"w-2.5 h-2.5 rounded-full bg-red-500/50\" data-kid=\"139\"></div>\n          <div class=\"w-2.5 h-2.5 rounded-full bg-yellow-500/50\" data-kid=\"140\"></div>\n          <div class=\"w-2.5 h-2.5 rounded-full bg-green-500/50\" data-kid=\"141\"></div>\n          <span class=\"ml-4 font-mono text-[10px] text-white/30 uppercase tracking-widest\" data-kid=\"142\">contact_module.sh — 80x24</span>\n        </div>\n        <div class=\"p-8 font-mono text-sm space-y-4\" data-kid=\"143\">\n          <div class=\"flex gap-4\" data-kid=\"144\">\n            <span class=\"text-[var(--color-brand-purple)]\" data-kid=\"145\">guest@portfolio:~$</span>\n            <span class=\"text-white/80\" data-kid=\"146\">execute contact_protocol --init</span>\n          </div>\n          <div class=\"text-white/40 leading-relaxed\" data-kid=\"147\">\n            [SYS] Initializing SMTP relay...<br data-kid=\"148\">\n            [SYS] Securing handshake with alchemist@creative.dev...<br data-kid=\"149\">\n            [SYS] Waiting for user input...\n          </div>\n          <div class=\"pt-6 border-t border-white/5 space-y-6\" data-kid=\"150\">\n            <div class=\"group\" data-kid=\"151\">\n              <label class=\"block text-[10px] text-[var(--color-neon-flame)] uppercase mb-2\" data-kid=\"152\">Identifier</label>\n              <div class=\"flex items-center gap-2\" data-kid=\"153\">\n                <span class=\"text-white/20\" data-kid=\"154\">></span>\n                <input type=\"text\" placeholder=\"Who are you?\" class=\"bg-transparent border-none outline-none text-white w-full placeholder:text-white/10\" data-kid=\"155\">\n              </div>\n            </div>\n            <div class=\"group\" data-kid=\"156\">\n              <label class=\"block text-[10px] text-[var(--color-neon-flame)] uppercase mb-2\" data-kid=\"157\">Intent</label>\n              <div class=\"flex items-center gap-2\" data-kid=\"158\">\n                <span class=\"text-white/20\" data-kid=\"159\">></span>\n                <input type=\"text\" placeholder=\"What is your purpose?\" class=\"bg-transparent border-none outline-none text-white w-full placeholder:text-white/10\" data-kid=\"160\">\n              </div>\n            </div>\n            <div class=\"group\" data-kid=\"161\">\n              <label class=\"block text-[10px] text-[var(--color-neon-flame)] uppercase mb-2\" data-kid=\"162\">Message Payload</label>\n              <div class=\"flex items-start gap-2\" data-kid=\"163\">\n                <span class=\"text-white/20 mt-1\" data-kid=\"164\">></span>\n                <textarea placeholder=\"Transmit your vision...\" class=\"bg-transparent border-none outline-none text-white w-full h-24 placeholder:text-white/10 resize-none\" data-kid=\"165\"></textarea>\n              </div>\n            </div>\n          </div>\n          <div class=\"pt-4 flex items-center justify-between\" data-kid=\"166\">\n            <div class=\"flex gap-4\" data-kid=\"167\">\n               <span class=\"text-[var(--color-brand-purple)]\" data-kid=\"168\">guest@portfolio:~$</span>\n               <span class=\"text-white/80 animate-pulse\" data-kid=\"169\">send<span class=\"cursor\" data-kid=\"170\"></span></span>\n            </div>\n            <button class=\"px-6 py-2 bg-[var(--color-neon-flame)] text-black font-bold uppercase text-xs tracking-tighter hover:brightness-110 transition-all\" data-kid=\"171\">\n              RUN_TRANSMISSION\n            </button>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"mt-32 pt-16 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"172\">\n        <div class=\"flex gap-8 text-[var(--color-brand-purple)] text-xl\" data-kid=\"173\">\n          <a href=\"#\" class=\"hover:text-[var(--color-neon-flame)] transition-colors\" data-kid=\"174\"><i class=\"ti ti-brand-github\" data-kid=\"175\"></i></a>\n          <a href=\"#\" class=\"hover:text-[var(--color-neon-flame)] transition-colors\" data-kid=\"176\"><i class=\"ti ti-brand-linkedin\" data-kid=\"177\"></i></a>\n          <a href=\"#\" class=\"hover:text-[var(--color-neon-flame)] transition-colors\" data-kid=\"178\"><i class=\"ti ti-brand-twitter\" data-kid=\"179\"></i></a>\n        </div>\n        <div class=\"text-center md:text-right\" data-kid=\"180\">\n          <p class=\"font-mono text-[10px] text-white/20 uppercase tracking-[0.2em] mb-2\" data-kid=\"181\">Handcrafted by Frontend Alchemist</p>\n          <p class=\"font-mono text-[10px] text-white/10\" data-kid=\"182\">© 2026 CYCLE_EX_01. ALL PROTOCOLS RESERVED.</p>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"183\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"184\"></script>\n<script data-kid=\"185\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Parallax for floating core\n  gsap.to(\".animate-float\", {\n    y: -30,\n    duration: 3,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  // Fade in sections on scroll\n  gsap.utils.toArray('section').forEach(section => {\n    gsap.from(section, {\n      opacity: 0,\n      y: 50,\n      duration: 1,\n      scrollTrigger: {\n        trigger: section,\n        start: \"top 80%\",\n        end: \"top 20%\",\n        toggleActions: \"play none none reverse\"\n      }\n    });\n  });\n</script>",
