      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;800&family=Space+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --color-deep-space: #12091f;\n    --color-neon-flame: #FF4F00;\n    --color-magenta-bloom: #D1227A;\n    --color-brand-purple: #8a5cff;\n  }\n\n  body {\n    background-color: var(--color-deep-space);\n    color: white;\n    font-family: 'Space Mono', monospace;\n    overflow-x: hidden;\n  }\n\n  .font-sora { font-family: 'Sora', sans-serif; }\n\n  /* Glitch Effect */\n  .glitch {\n    position: relative;\n    display: inline-block;\n  }\n  .glitch::before, .glitch::after {\n    content: attr(data-text);\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: var(--color-deep-space);\n  }\n  .glitch::before {\n    left: 2px;\n    text-shadow: -2px 0 var(--color-neon-flame);\n    clip: rect(44px, 450px, 56px, 0);\n    animation: glitch-anim 5s infinite linear alternate-reverse;\n  }\n  .glitch::after {\n    left: -2px;\n    text-shadow: -2px 0 var(--color-magenta-bloom);\n    clip: rect(44px, 450px, 56px, 0);\n    animation: glitch-anim2 5s infinite linear alternate-reverse;\n  }\n\n  @keyframes glitch-anim {\n    0% { clip: rect(31px, 9999px, 94px, 0); }\n    20% { clip: rect(62px, 9999px, 42px, 0); }\n    40% { clip: rect(16px, 9999px, 78px, 0); }\n    60% { clip: rect(87px, 9999px, 12px, 0); }\n    80% { clip: rect(4px, 9999px, 55px, 0); }\n    100% { clip: rect(72px, 9999px, 28px, 0); }\n  }\n  @keyframes glitch-anim2 {\n    0% { clip: rect(65px, 9999px, 100px, 0); }\n    20% { clip: rect(12px, 9999px, 58px, 0); }\n    40% { clip: rect(94px, 9999px, 15px, 0); }\n    60% { clip: rect(33px, 9999px, 82px, 0); }\n    80% { clip: rect(50px, 9999px, 5px, 0); }\n    100% { clip: rect(2px, 9999px, 44px, 0); }\n  }\n\n  .glass {\n    background: rgba(27, 16, 49, 0.4);\n    backdrop-filter: blur(12px);\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .magenta-glow {\n    box-shadow: 0 0 40px -10px var(--color-magenta-bloom);\n  }\n\n  .custom-scrollbar::-webkit-scrollbar {\n    height: 4px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: var(--color-magenta-bloom);\n    border-radius: 10px;\n  }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <div class=\"fixed inset-0 -z-20 opacity-20 overflow-hidden\" data-kid=\"2\">\n    <video src=\"https://videos.pexels.com/video-files/7762067/7762067-sd_640_360_25fps.mp4\" poster=\"https://images.pexels.com/videos/7762067/pexels-photo-7762067.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover\" data-kid=\"3\">\n    </video>\n  </div>\n\n  \n  <nav class=\"fixed top-0 w-full z-50 px-8 py-6 flex justify-between items-center mix-blend-difference\" data-kid=\"4\">\n    <div class=\"text-xl font-sora font-extrabold tracking-tighter\" data-kid=\"5\">\n      HIEU<span class=\"text-[var(--color-magenta-bloom)]\" data-kid=\"6\">.</span>HK\n    </div>\n    <div class=\"flex gap-12 text-xs uppercase tracking-widest opacity-60\" data-kid=\"7\">\n      <a href=\"#story\" class=\"hover:opacity-100 transition-opacity\" data-kid=\"8\">The Journey</a>\n      <a href=\"#work\" class=\"hover:opacity-100 transition-opacity\" data-kid=\"9\">Artifacts</a>\n      <a href=\"#skills\" class=\"hover:opacity-100 transition-opacity\" data-kid=\"10\">Matrix</a>\n      <a href=\"#contact\" class=\"hover:opacity-100 transition-opacity\" data-kid=\"11\">Execute</a>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative h-screen flex flex-col items-center justify-center px-4 overflow-hidden\" data-kid=\"12\">\n    <div class=\"relative z-10 text-center\" data-kid=\"13\">\n      <p class=\"text-xs uppercase tracking-[0.5em] mb-4 opacity-40 font-bold\" data-kid=\"14\">Initiating Portfolio_v2.0</p>\n      <h1 class=\"font-sora text-7xl md:text-9xl font-extrabold tracking-tighter leading-none glitch\" data-text=\"FRONTEND ALCHEMIST\" data-kid=\"15\">\n        FRONTEND ALCHEMIST\n      </h1>\n      <p class=\"mt-8 max-w-lg mx-auto text-sm opacity-60 leading-relaxed font-light\" data-kid=\"16\">\n        Transmuting complex logic into ethereal user experiences. Specialized in React, interactive motion, and the elegant void of clean code.\n      </p>\n    </div>\n\n    \n    <div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] pointer-events-none\" data-kid=\"17\">\n      <img src=\"https://images.unsplash.com/photo-1709377195538-5522ed0f9e10?auto=format&w=800&q=80&fit=crop\" alt=\"Core\" class=\"w-full h-full object-contain opacity-40 mix-blend-screen animate-floaty\" decoding=\"async\" loading=\"lazy\" data-kid=\"18\">\n    </div>\n  </section>\n\n  \n  <section id=\"story\" class=\"py-32 relative\" data-kid=\"19\">\n    <div class=\"px-12 mb-16\" data-kid=\"20\">\n      <h2 class=\"font-sora text-4xl font-bold tracking-tight\" data-kid=\"21\">The Journey Arcana</h2>\n      <div class=\"h-px w-24 bg-[var(--color-magenta-bloom)] mt-4\" data-kid=\"22\"></div>\n    </div>\n    \n    <div class=\"flex gap-8 px-12 overflow-x-auto custom-scrollbar pb-12 snap-x\" data-kid=\"23\">\n      \n      <div class=\"min-w-[320px] h-[500px] snap-center glass p-8 flex flex-col justify-between group hover:border-[var(--color-magenta-bloom)]/30 transition-all duration-500\" data-kid=\"24\">\n        <div data-kid=\"25\">\n          <span class=\"text-6xl opacity-10 font-sora italic\" data-kid=\"26\">01</span>\n          <h3 class=\"text-xl font-sora font-bold mt-4 tracking-tight\" data-kid=\"27\">The Novice</h3>\n          <p class=\"text-sm opacity-50 mt-4 leading-relaxed\" data-kid=\"28\">Where binary curiosity first ignited. Mastering the foundational elements of the web DOM.</p>\n        </div>\n        <div class=\"relative h-32 flex items-center justify-center\" data-kid=\"29\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/cube.svg\" class=\"w-16 h-16 opacity-20 group-hover:opacity-100 transition-opacity duration-700 group-hover:rotate-45\" style=\"filter: drop-shadow(0 0 10px var(--color-magenta-bloom));\" alt=\"Icon\" data-kid=\"30\">\n        </div>\n      </div>\n\n      \n      <div class=\"min-w-[320px] h-[500px] snap-center glass p-8 flex flex-col justify-between group hover:border-[var(--color-magenta-bloom)]/30 transition-all duration-500 magenta-glow\" data-kid=\"31\">\n        <div data-kid=\"32\">\n          <span class=\"text-6xl opacity-10 font-sora italic\" data-kid=\"33\">02</span>\n          <h3 class=\"text-xl font-sora font-bold mt-4 tracking-tight\" data-kid=\"34\">The Architect</h3>\n          <p class=\"text-sm opacity-50 mt-4 leading-relaxed\" data-kid=\"35\">Scaling complexity. Crafting robust React ecosystems and design systems that breathe.</p>\n        </div>\n        <div class=\"relative h-32 flex items-center justify-center\" data-kid=\"36\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/pentagram-rose.svg\" class=\"w-20 h-20 opacity-20 group-hover:opacity-100 transition-opacity duration-700 animate-spin-slow\" style=\"filter: drop-shadow(0 0 20px var(--color-magenta-bloom));\" alt=\"Icon\" data-kid=\"37\">\n        </div>\n      </div>\n\n      \n      <div class=\"min-w-[320px] h-[500px] snap-center glass p-8 flex flex-col justify-between group hover:border-[var(--color-magenta-bloom)]/30 transition-all duration-500\" data-kid=\"38\">\n        <div data-kid=\"39\">\n          <span class=\"text-6xl opacity-10 font-sora italic\" data-kid=\"40\">03</span>\n          <h3 class=\"text-xl font-sora font-bold mt-4 tracking-tight\" data-kid=\"41\">The Innovator</h3>\n          <p class=\"text-sm opacity-50 mt-4 leading-relaxed\" data-kid=\"42\">Pushing boundaries. Immersive 3D, complex animations, and AI-driven frontend synthesis.</p>\n        </div>\n        <div class=\"relative h-32 flex items-center justify-center\" data-kid=\"43\">\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/heptagram.svg\" class=\"w-20 h-20 opacity-20 group-hover:opacity-100 transition-opacity duration-700\" style=\"filter: drop-shadow(0 0 10px var(--color-magenta-bloom));\" alt=\"Icon\" data-kid=\"44\">\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"work\" class=\"py-32 bg-black/40\" data-kid=\"45\">\n    <div class=\"max-w-6xl mx-auto px-12 mb-32\" data-kid=\"46\">\n      <h2 class=\"font-sora text-6xl font-extrabold tracking-tighter text-center\" data-kid=\"47\">SELECTED ARTIFACTS</h2>\n    </div>\n\n    <div class=\"relative h-[800px] w-full max-w-7xl mx-auto\" data-kid=\"48\">\n      \n      <div class=\"absolute top-0 left-10 w-[450px] glass p-4 rotate-[-4deg] hover:rotate-0 hover:z-30 hover:scale-105 transition-all duration-500 cursor-pointer\" data-kid=\"49\">\n        <img src=\"https://images.pexels.com/photos/11723903/pexels-photo-11723903.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\" class=\"w-full h-64 object-cover grayscale hover:grayscale-0 transition-all\" alt=\"Work\" decoding=\"async\" loading=\"lazy\" data-kid=\"50\">\n        <div class=\"mt-4 flex justify-between items-end\" data-kid=\"51\">\n          <div data-kid=\"52\">\n            <h4 class=\"font-sora font-bold text-lg\" data-kid=\"53\">NEBULA_OS</h4>\n            <p class=\"text-xs opacity-40\" data-kid=\"54\">AI Visualization Dashboard</p>\n          </div>\n          <span class=\"text-[10px] border border-white/20 px-2 py-1 rounded\" data-kid=\"55\">2024</span>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute top-40 right-20 w-[400px] glass p-4 rotate-[6deg] hover:rotate-0 hover:z-30 hover:scale-105 transition-all duration-500 cursor-pointer border-[var(--color-magenta-bloom)]/40\" data-kid=\"56\">\n        <img src=\"https://images.pexels.com/photos/33879244/pexels-photo-33879244.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\" class=\"w-full h-72 object-cover\" alt=\"Work\" decoding=\"async\" loading=\"lazy\" data-kid=\"57\">\n        <div class=\"mt-4\" data-kid=\"58\">\n          <h4 class=\"font-sora font-bold text-lg\" data-kid=\"59\">CYBER_CORE</h4>\n          <p class=\"text-xs opacity-40\" data-kid=\"60\">Interactive Fiber Optics Simulation</p>\n        </div>\n      </div>\n\n      \n      <div class=\"absolute bottom-20 left-1/4 w-[420px] glass p-4 rotate-[-2deg] hover:rotate-0 hover:z-30 hover:scale-105 transition-all duration-500 cursor-pointer\" data-kid=\"61\">\n        <img src=\"https://images.pexels.com/photos/12843337/pexels-photo-12843337.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\" class=\"w-full h-64 object-cover opacity-80\" alt=\"Work\" decoding=\"async\" loading=\"lazy\" data-kid=\"62\">\n        <div class=\"mt-4\" data-kid=\"63\">\n          <h4 class=\"font-sora font-bold text-lg\" data-kid=\"64\">BRUTAL_UI</h4>\n          <p class=\"text-xs opacity-40\" data-kid=\"65\">Experimental Layout Framework</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"skills\" class=\"py-32 px-12\" data-kid=\"66\">\n    <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-0.5 bg-white/5 border border-white/5\" data-kid=\"67\">\n      \n      {[\n        { label: 'React.js', size: 'col-span-2' },\n        { label: 'GSAP', size: '' },\n        { label: 'Three.js', size: 'row-span-2' },\n        { label: 'Tailwind', size: '' },\n        { label: 'WebGL', size: '' },\n        { label: 'Node.js', size: '' },\n        { label: 'Redux', size: '' },\n        { label: 'Framer', size: 'col-span-2' },\n        { label: 'Next.js', size: '' },\n        { label: 'TypeScript', size: 'col-span-2' },\n        { label: 'PostCSS', size: '' },\n        { label: 'Webpack', size: '' },\n        { label: 'Vite', size: '' },\n        { label: 'SQL', size: '' }\n      ].map((skill, i) => (\n        <div key=\"{i}\" className=\"{`bg-[var(--color-deep-space)]\" p-8 border border-white flex flex-col justify-center items-center group hover:bg-[var(--color-magenta-bloom)] transition-colors $ skill.size data-kid=\"68\">\n          <i class=\"ti ti-terminal text-2xl mb-4 opacity-20 group-hover:text-[var(--color-neon-flame)] group-hover:opacity-100 transition-all\" data-kid=\"69\"></i>\n          <span class=\"text-xs uppercase tracking-widest font-bold opacity-40 group-hover:opacity-100\" data-kid=\"70\">{skill.label}</span>\n        </div>\n      ))}\n    </div>\n  </section>\n\n  \n  <footer id=\"contact\" class=\"pt-32 pb-16 px-12\" data-kid=\"71\">\n    <div class=\"max-w-4xl mx-auto glass p-10 border-t-2 border-[var(--color-magenta-bloom)]\" data-kid=\"72\">\n      <div class=\"flex items-center gap-2 mb-6 opacity-30 text-xs\" data-kid=\"73\">\n        <i class=\"ti ti-terminal\" data-kid=\"74\"></i>\n        <span data-kid=\"75\">guest@hieu_hk:~/portfolio/contact</span>\n      </div>\n      \n      <div class=\"space-y-6\" data-kid=\"76\">\n        <div class=\"flex gap-4 items-start\" data-kid=\"77\">\n          <span class=\"text-[var(--color-neon-flame)] font-bold\" data-kid=\"78\">❯</span>\n          <div class=\"w-full\" data-kid=\"79\">\n            <p class=\"text-sm mb-4\" data-kid=\"80\">Would you like to initiate the connection protocol?</p>\n            <div class=\"relative\" data-kid=\"81\">\n              <input type=\"text\" placeholder=\"Type your message here...\" class=\"w-full bg-transparent border-b border-white/10 py-4 text-xl font-sora focus:outline-none focus:border-[var(--color-magenta-bloom)] transition-colors\" data-kid=\"82\">\n              <div class=\"absolute right-0 bottom-4 animate-pulse h-8 w-0.5 bg-[var(--color-magenta-bloom)]\" data-kid=\"83\"></div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"flex justify-end mt-12\" data-kid=\"84\">\n          <button class=\"group flex items-center gap-4 bg-[var(--color-magenta-bloom)] px-8 py-4 font-bold text-sm tracking-tighter uppercase hover:bg-white hover:text-black transition-all\" data-kid=\"85\">\n            Execute Protocol\n            <i class=\"ti ti-send group-hover:translate-x-2 transition-transform\" data-kid=\"86\"></i>\n          </button>\n        </div>\n      </div>\n\n      <div class=\"mt-24 pt-12 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8 opacity-40 text-[10px] tracking-widest uppercase\" data-kid=\"87\">\n        <div class=\"flex gap-8\" data-kid=\"88\">\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"89\">Github</a>\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"90\">LinkedIn</a>\n          <a href=\"#\" class=\"hover:text-white transition-colors\" data-kid=\"91\">Dribbble</a>\n        </div>\n        <div data-kid=\"92\">Designed in the Void &copy; 2026</div>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script data-kid=\"93\">\n  // Simple Animation Controller (Placeholder for GSAP if needed later)\n  document.addEventListener('DOMContentLoaded', () => {\n    console.log('Void Elegant Loaded');\n  });\n</script>",
